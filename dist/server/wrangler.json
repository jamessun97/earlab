{
  "name": "earlab",
  "main": "index.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "../client",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "earlab-progress",
      "database_id": "local-earlab-progress",
      "migrations_dir": "../../drizzle"
    }
  ]
}